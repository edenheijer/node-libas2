{
  "name": "libas2",
  "alternateName": "node-libas2",
  "version": "0.5.8-wgdh.1",
  "description": "Implementation of the AS2 protocol as presented in RFC 4130 and related RFCs (WG Den Heijer fork of libas2 0.5.7, modernized dependencies)",
  "main": "dist/core.js",
  "types": "dist/core.d.ts",
  "files": [
    "LICENSE",
    "dist/**"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "keywords": [
    "as2",
    "RFC4130",
    "as2 protocol",
    "mdn",
    "edi"
  ],
  "author": "Aaron Huggins",
  "contributors": [
    "W.G. den Heijer & Zn. B.V."
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/edenheijer/node-libas2"
  },
  "homepage": "https://github.com/edenheijer/node-libas2#readme",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "asn1js": "^4.0.0",
    "nodemailer": "^10.4.0",
    "pkijs": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "libas2-legacy": "npm:libas2@0.5.7",
    "nock": "^14.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  }
}
