{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "useDefineForClassFields": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "removeComments": false,
    "outDir": "dist",
    "declaration": true,
    "types": ["node"]
  },
  "include": ["core.ts", "src/**/*.ts"]
}
